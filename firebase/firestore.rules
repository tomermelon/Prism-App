rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if isSelf(uid);
      allow delete: if false;
    }

    match /usernames/{username} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /articles/{articleId} {
      allow read: if signedIn();
      allow create, delete: if false;
      // Clients may only bump engagement counters (ingest uses Admin SDK).
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['likeCount', 'shareCount']);
    }

    match /likes/{likeId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    match /articles/{articleId}/comments/{commentId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.keys().hasAll([
          'authorId', 'authorUsername', 'text', 'parentId', 'likeCount', 'createdAt'
        ])
        && request.resource.data.likeCount == 0
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000;
      // Likes bump likeCount only; authors cannot edit text in v1.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
        && request.resource.data.likeCount is int
        && request.resource.data.likeCount >= 0;
      allow delete: if false;
    }

    match /commentLikes/{likeId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    match /friendRequests/{requestId} {
      // Missing docs: allow get so "does this request exist?" checks work.
      allow get: if signedIn() && (
        resource == null
        || resource.data.fromUid == request.auth.uid
        || resource.data.toUid == request.auth.uid
      );
      // List/query: only docs you send or receive (query must filter by fromUid or toUid).
      allow list: if signedIn()
        && (resource.data.fromUid == request.auth.uid
          || resource.data.toUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if signedIn()
        && (resource.data.toUid == request.auth.uid
          || resource.data.fromUid == request.auth.uid);
      allow delete: if false;
    }

    match /friendships/{friendshipId} {
      // App checks whether a friendship doc exists before sending a request.
      // Non-existent docs have resource == null; old rules crashed on resource.data.
      allow get: if signedIn() && (
        resource == null
        || resource.data.userA == request.auth.uid
        || resource.data.userB == request.auth.uid
      );
      allow list: if signedIn()
        && (resource.data.userA == request.auth.uid
          || resource.data.userB == request.auth.uid);
      allow create: if signedIn()
        && (request.resource.data.userA == request.auth.uid
          || request.resource.data.userB == request.auth.uid);
      allow update, delete: if false;
    }

    match /conversations/{conversationId} {
      allow get: if signedIn() && (
        resource == null
        || request.auth.uid in resource.data.participantIds
      );
      allow list: if signedIn()
        && request.auth.uid in resource.data.participantIds;
      allow update: if signedIn()
        && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participantIds;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds
          && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
